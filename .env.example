# 默认不需要任何凭证；离线运行 baseline/candidate。
# CLI 不自动读取 .env：使用 export 或 shell 环境配置；不要提交真实 .env。
WORKSPACE_AGENT_ENDPOINT=
WORKSPACE_AGENT_API_KEY=
RESEARCH_AGENT_ENDPOINT=
RESEARCH_AGENT_API_KEY=
# OpenAI-compatible: 显式配置 /v1 base URL 与 model；本地无认证服务可不填 key。
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=
